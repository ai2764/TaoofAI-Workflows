      },
      "widgets_values": [
        "{\n  \"subject_definitions\": \"<Picture 1> defines ONE adult woman Mia in a glossy opaque pearl-white fitted cyber suit with orange seams, slim armor and flat white boots. Its three views show the SAME woman. <Picture 2> defines the bright daytime rooftop platform and detailed futuristic city. <Picture 3> defines Mia's exact face and long dark brown half-tied hair. <Picture 4> defines the white-orange angular hardbody airship with cyan-core engines and open side hatch; it remains distant background above the roof. No other performers. <Video 1> supplies root positions, scale, broad facing direction and camera only, with deliberately unanimated joints.\",\n  \"summary\": \"A continuous cinematic action study of Mia, with natural model-authored articulation. \",\n  \"retention_analysis\": \"Keep Mia's face, white-orange suit, body proportions and daylight city stable. Replace every simple proxy body and box building with the referenced real woman and detailed architecture. The one rigid proxy is a positional guide only; freely animate its real replacement with natural steps, weight shifts, bent knees, arm swing and coherent hands. Keep two arms connected throughout turns. No slow motion, teleports, duplicated people or literal mannequins. One continuous shot.\",\n  \"detailed_description\": \"0-1.2 seconds: Full-body three-quarter tracking view; Mia starts a natural forward jog across the bright roof, looking along her route. 1.2-2.2 seconds: Build to a light run with connected footfalls and reciprocal arm swing. 2.2-2.9 seconds: Make ONE low forward jump, both feet briefly clear the deck, knees flex and land with a small visible compression. The root follows the small arc in <Video 1>. 2.9-4.2 seconds: Run out of the landing without stopping, arms and hips absorbing momentum naturally. 4.2-5.1667 seconds: Continue the SAME forward jog, one leg advancing and the other pushing off, a clear ongoing arm swing. End MID-STRIDE, still moving right along the deck, not posing or slowing; camera tracks at the same speed.\",\n  \"overall_soundscape\": \"Open rooftop wind, distant airship engine, synchronized running or walking steps, restrained breathing and suit movement. No dialogue.\",\n  \"non_diegetic_music\": \"N/A\"\n}"
      ],
      "widgets_values_named": {
        "value": "{\n  \"subject_definitions\": \"<Picture 1> defines ONE adult woman Mia in a glossy opaque pearl-white fitted cyber suit with orange seams, slim armor and flat white boots. Its three views show the SAME woman. <Picture 2> defines the bright daytime rooftop platform and detailed futuristic city. <Picture 3> defines Mia's exact face and long dark brown half-tied hair. <Picture 4> defines the white-orange angular hardbody airship with cyan-core engines and open side hatch; it remains distant background above the roof. No other performers. <Video 1> supplies root positions, scale, broad facing direction and camera only, with deliberately unanimated joints.\",\n  \"summary\": \"A continuous cinematic action study of Mia, with natural model-authored articulation. \",\n  \"retention_analysis\": \"Keep Mia's face, white-orange suit, body proportions and daylight city stable. Replace every simple proxy body and box building with the referenced real woman and detailed architecture. The one rigid proxy is a positional guide only; freely animate its real replacement with natural steps, weight shifts, bent knees, arm swing and coherent hands. Keep two arms connected throughout turns. No slow motion, teleports, duplicated people or literal mannequins. One continuous shot.\",\n  \"detailed_description\": \"0-1.2 seconds: Full-body three-quarter tracking view; Mia starts a natural forward jog across the bright roof, looking along her route. 1.2-2.2 seconds: Build to a light run with connected footfalls and reciprocal arm swing. 2.2-2.9 seconds: Make ONE low forward jump, both feet briefly clear the deck, knees flex and land with a small visible compression. The root follows the small arc in <Video 1>. 2.9-4.2 seconds: Run out of the landing without stopping, arms and hips absorbing momentum naturally. 4.2-5.1667 seconds: Continue the SAME forward jog, one leg advancing and the other pushing off, a clear ongoing arm swing. End MID-STRIDE, still moving right along the deck, not posing or slowing; camera tracks at the same speed.\",\n  \"overall_soundscape\": \"Open rooftop wind, distant airship engine, synchronized running or walking steps, restrained breathing and suit movement. No dialogue.\",\n  \"non_diegetic_music\": \"N/A\"\n}"
      }
